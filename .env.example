# ===== Tran Luu QR Order & Sports POS System - Environment Variables =====
# Sao chép file này thành .env (dev) hoặc .env.production (production)
# Tạo secrets ngẫu nhiên: npm run generate:secrets
# KHÔNG COMMIT file .env hay .env.production vào git!

# ===========================================================================
# 1. Cơ sở dữ liệu MongoDB
# ===========================================================================
# Production: BẮT BUỘC Replica Set cho ACID Transaction
# (P0/Issue #1: standalone MongoDB không atomic — nguy cơ mất dữ liệu)
MONGO_URI=mongodb://app_user:MONGO_APP_PASSWORD@localhost:27017/tran_luu_qr_order?authSource=tran_luu_qr_order&replicaSet=rs0

# Tên database
DB_NAME=tran_luu_qr_order

# SECURITY: Tuyệt đối KHÔNG đặt ALLOW_STANDALONE=true trong production
# Nếu MongoDB không hỗ trợ replica set trong dev: tsx scripts/setup-mongo-replica.ts
ALLOW_STANDALONE=false   # Chỉ đặt true cho dev local, KHÔNG bao giờ production

# MongoDB credentials (dùng trong docker-compose.prod.yml). Dùng chuỗi hex để
# tránh ký tự đặc biệt làm hỏng MongoDB URI khi Compose nội suy biến môi trường.
# Tạo bằng: openssl rand -hex 32
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD_HERE
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD_HERE

# ===========================================================================
# 2. Cổng dịch vụ & Môi trường
# ===========================================================================
PORT=3001
NODE_ENV=production

# ===========================================================================
# 3. Nguồn gốc công khai (CORS / CSRF / Proxy)
# ===========================================================================
# Production: phải là https://your-domain.com (không trailing slash, không localhost)
# (P1/Issue #3: sai domain → bypass CORS protection)
PUBLIC_ORIGIN=https://order.tranluubadminton.vn

# P1/Issue #3 FIX: CIDR của reverse proxy thực tế (Nginx/Traefik/Cloudflare)
# Chỉ trust IP từ proxy hợp lệ — không dùng số hop (trust proxy 1)
# Docker internal network: thường 172.x.x.x/8
# Cloudflare: xem https://www.cloudflare.com/ips/
# Nhiều CIDRs: phân cách bằng dấu phẩy
TRUSTED_PROXY_CIDRS=172.0.0.0/8

# ===========================================================================
# 4. Tài khoản Quản trị viên ENV (Super Admin)
# ===========================================================================
ADMIN_USERNAME=admin

# Tạo hash scrypt bằng: npm run generate:secrets
# Định dạng bắt buộc: <32_hex_salt>:<128_hex_scrypt_hash>
# P2/Issue #9: Mật khẩu phải >= 10 ký tự, không phổ biến
ADMIN_PASSWORD_HASH=GENERATE_WITH_npm_run_generate:secrets

# ===========================================================================
# 5. Khóa bảo mật QR Code
# ===========================================================================
# Tối thiểu 32 ký tự ngẫu nhiên — dùng: openssl rand -base64 48
# KHÔNG dùng giá trị mặc định/example trong production
QR_SIGN_SECRET=CHANGE_ME_USE_openssl_rand_-base64_48

# ===========================================================================
# 6. Cookie & Session Security
# ===========================================================================
# Tối thiểu 32 ký tự — dùng: openssl rand -base64 48
COOKIE_SECRET=CHANGE_ME_USE_openssl_rand_-base64_48

# ===========================================================================
# 7. Redis Cache & Pub/Sub (Required cho multi-instance)
# ===========================================================================
# P2/Issue #18: Production multi-instance PHẢI có Redis — không fallback in-memory
REDIS_ENABLED=true

# Với password (P0/Issue #2: Redis phải có authentication trong production)
REDIS_URL=redis://:REDIS_PASSWORD_HERE@localhost:6379

# Redis credentials (dùng trong docker-compose.prod.yml)
# Tạo bằng: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE
