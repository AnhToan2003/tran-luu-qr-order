# ===== Tran Luu QR Order & Sports POS System - Environment Variables =====
# Copy file này thành .env và cấu hình giá trị thực cho môi trường chạy

# 1. Cơ sở dữ liệu MongoDB (Bắt buộc Replica Set cho môi trường Production để hỗ trợ ACID Transaction)
MONGO_URI=mongodb://localhost:27017/tran_luu_qr_order?replicaSet=rs0
DB_NAME=tran_luu_qr_order
# Nếu chạy local mà không dùng Replica Set, đặt ALLOW_STANDALONE=true (không khuyến nghị cho production)
ALLOW_STANDALONE=false

# 2. Cổng dịch vụ (Port) và Môi trường
PORT=3001
NODE_ENV=production

# 3. Nguồn gốc công khai (CORS / CSRF origin check)
PUBLIC_ORIGIN=http://localhost:3001

# 4. Tài khoản Quản trị viên cấp cao nhất (Super Admin qua biến môi trường)
ADMIN_USERNAME=admin
# Tạo hash scrypt bằng lệnh: npm run hash-password <mat_khau_cua_ban>
# Định dạng: <salt_32_hex>:<hash_128_hex>
ADMIN_PASSWORD_HASH=92a5b6f3c14d5e82b79a0c18374d6f82:a1b2c3d4e5f6...

# 5. Khóa ký HMAC xác thực mã QR bàn / sân (Tối thiểu 32 ký tự ngẫu nhiên)
QR_SIGN_SECRET=thay-the-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu-bao-mat

# 6. Khóa bảo mật Cookie phiên đăng nhập
COOKIE_SECRET=thay-the-bang-chuoi-cookie-secret-ngau-nhien-an-toan

# 7. Redis Cache & Pub/Sub Đa phiên bản (Tùy chọn - fallback In-Memory nếu không có hoặc đặt REDIS_ENABLED=false)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
