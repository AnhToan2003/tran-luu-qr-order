{
  "name": "tran-luu-qr-order",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json && node scripts/build.mjs",
    "start": "node dist-server/index.js",
    "start:prod": "node scripts/start-production.mjs",
    "build:ci": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint src server scripts tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:frontend": "vitest run tests/frontend",
    "test:coverage": "vitest run --coverage",
    "check:openapi": "vitest run tests/unit/openapi-contract.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:ui:server": "tsx scripts/preview-test.ts",
    "seed": "tsx server/seedData.ts",
    "mongo:replica": "tsx scripts/setup-mongo-replica.ts",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "generate:secrets:staging": "tsx scripts/generate-secrets.ts --target=staging",
    "check:prod": "tsx scripts/verify-production.ts",
    "check:prod:strict": "npm run build && tsx scripts/verify-production.ts --strict",
    "check:staging": "tsx scripts/verify-production.ts --env-file=.env.staging",
    "check:staging:strict": "npm run build && tsx scripts/verify-production.ts --strict --env-file=.env.staging",
    "production:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config --quiet",
    "production:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "production:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "production:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f app",
    "staging:config": "docker compose --env-file .env.staging -f docker-compose.prod.yml -f docker-compose.staging.yml config --quiet",
    "staging:up": "docker compose --env-file .env.staging -f docker-compose.prod.yml -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose --env-file .env.staging -f docker-compose.prod.yml -f docker-compose.staging.yml down",
    "staging:logs": "docker compose --env-file .env.staging -f docker-compose.prod.yml -f docker-compose.staging.yml logs -f app",
    "backup:dump": "tsx scripts/backup-mongodump.ts",
    "backup:restore:drill": "tsx scripts/restore-drill.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.6.0",
    "proxy-addr": "^2.0.8",
    "swagger-ui-dist": "^5.33.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "mongodb-memory-server": "^11.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
