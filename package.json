{
  "name": "tran-luu-qr-order",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && node scripts/build.mjs",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "build:ci": "npm run test && npm run build",
    "preview": "vite preview",
    "test:ui:server": "tsx scripts/preview-test.ts",
    "seed": "tsx server/seedData.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "qrcode": "^1.5.4",
    "jspdf": "^4.2.1",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
