# Copy to .env.staging, then generate unique staging secrets. Never copy secrets
# from production. Staging runs NODE_ENV=production so security behavior matches.
NODE_ENV=production
APP_ENV=staging
COMPOSE_PROJECT_NAME=tran-luu-staging
ENV_FILE=.env.staging
PORT=3002
PUBLIC_ORIGIN=https://staging.order.tranluubadminton.vn

DB_NAME=tran_luu_qr_order_staging
ALLOW_STANDALONE=false
MONGO_ROOT_USER=mongoadmin_staging
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=appuser_staging
MONGO_APP_PASSWORD=
MONGO_KEYFILE_PATH=./docker/secrets/mongo-keyfile-staging
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_POOL_SIZE=20

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
QR_SIGN_SECRET=
QR_SIGN_SECRET_LEGACY=
QR_ALLOW_LEGACY_TAGS=false
COOKIE_SECRET=
REDIS_ENABLED=true
REDIS_PASSWORD=
INTERNAL_HEALTH_TOKEN=

PROXY_SUBNET=172.30.0.0/24
TRUSTED_PROXY_CIDRS=172.30.0.0/24
LOG_LEVEL=info
LOG_REQUESTS=false
LOG_INCLUDE_STACK=false
API_DOCS_ENABLED=false

BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_OFFSITE_HOST_PATH=./backups-offsite-staging
