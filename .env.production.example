# ===================================================================
# SÂN CẦU LÔNG TRẦN LỰU - CẤU HÌNH MẪU CHO MÔI TRƯỜNG PRODUCTION
# Hướng dẫn: Sao chép file này thành .env.production và điền các giá trị thực tế
# ===================================================================

# 1. Chế độ môi trường & Cổng chạy
NODE_ENV=production
PORT=3001

# 2. Tên miền thực tế (BẮT BUỘC HTTPS trên Production)
# Ví dụ: https://order.tranluubadminton.vn hoặc https://api.yourdomain.com
PUBLIC_ORIGIN=https://order.tranluubadminton.vn

# 3. Kết nối Cơ sở dữ liệu MongoDB (BẮT BUỘC Replica Set cho ACID Transactions)
# Ví dụ cụm Docker: mongodb://mongodb:27017/tran_luu_qr_order?replicaSet=rs0
# Ví dụ Atlas / External: mongodb+srv://user:password@cluster.mongodb.net/tran_luu_qr_order
MONGO_URI=mongodb://mongodb:27017/tran_luu_qr_order?replicaSet=rs0
DB_NAME=tran_luu_qr_order
ALLOW_STANDALONE=false

# Docker MongoDB credentials (must be changed; do not commit real secrets).
# Prefer hex-only values so the generated MongoDB URI remains valid.
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-secret
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=replace-with-a-different-long-random-secret

# 4. Tài khoản Quản trị viên Super Admin (Mặc định: admin)
ADMIN_USERNAME=admin
# Tạo hash scrypt: npm run generate:secrets
ADMIN_PASSWORD_HASH=

# 5. Khóa ký HMAC xác thực mã QR bàn & sân (Tối thiểu 64 ký tự hex ngẫu nhiên)
# Sinh tự động: npm run generate:secrets
QR_SIGN_SECRET=
# Optional during QR key rotation: old secret remains accepted until all QR
# stickers have been regenerated.
QR_SIGN_SECRET_LEGACY=

# 6. Khóa bảo mật mã hóa Cookie phiên làm việc (Tối thiểu 64 ký tự hex ngẫu nhiên)
# Sinh tự động: npm run generate:secrets
COOKIE_SECRET=

# 7. Redis Cache & Realtime Pub/Sub (Khuyên dùng cho cụm backend)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace-with-a-long-random-secret

# Comma-separated trusted reverse-proxy CIDRs, or leave empty when no proxy is used
TRUSTED_PROXY_CIDRS=

# Structured logs go to stdout and are searchable in the hosting provider.
LOG_LEVEL=info
LOG_REQUESTS=false
LOG_INCLUDE_STACK=false

# Before starting Docker Compose, provision docker/secrets/mongo-keyfile
# with a random 756-byte base64 key and chmod 400. Never commit this file.
