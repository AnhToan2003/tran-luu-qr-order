# ===================================================================
# SÂN CẦU LÔNG TRẦN LỰU - CẤU HÌNH MẪU CHO MÔI TRƯỜNG PRODUCTION
# Hướng dẫn: Sao chép file này thành .env.production và điền các giá trị thực tế
# ===================================================================

# 1. Chế độ môi trường & Cổng chạy
NODE_ENV=production
PORT=3001

# 2. Tên miền thực tế (BẮT BUỘC HTTPS trên Production)
# Ví dụ: https://order.tranluubadminton.vn hoặc https://api.yourdomain.com
PUBLIC_ORIGIN=https://order.tranluubadminton.vn

# 3. Kết nối Cơ sở dữ liệu MongoDB (BẮT BUỘC Replica Set cho ACID Transactions)
# Ví dụ cụm Docker: mongodb://mongodb:27017/tran_luu_qr_order?replicaSet=rs0
# Ví dụ Atlas / External: mongodb+srv://user:password@cluster.mongodb.net/tran_luu_qr_order
MONGO_URI=mongodb://mongodb:27017/tran_luu_qr_order?replicaSet=rs0
DB_NAME=tran_luu_qr_order

# 4. Tài khoản Quản trị viên Super Admin (Mặc định: admin)
ADMIN_USERNAME=admin
# Tạo hash scrypt: npm run generate:secrets
ADMIN_PASSWORD_HASH=

# 5. Khóa ký HMAC xác thực mã QR bàn & sân (Tối thiểu 64 ký tự hex ngẫu nhiên)
# Sinh tự động: npm run generate:secrets
QR_SIGN_SECRET=

# 6. Khóa bảo mật mã hóa Cookie phiên làm việc (Tối thiểu 64 ký tự hex ngẫu nhiên)
# Sinh tự động: npm run generate:secrets
COOKIE_SECRET=

# 7. Redis Cache & Realtime Pub/Sub (Khuyên dùng cho cụm backend)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
